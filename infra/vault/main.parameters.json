{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "workloadName": { "value": "${VAULT_WORKLOAD_NAME=vault}" },
    "environmentShort": { "value": "${VAULT_ENVIRONMENT_SHORT=dev}" },
    "nameSuffix": { "value": "${VAULT_NAME_SUFFIX}" },
    "vaultExists": { "value": "${SERVICE_VAULT_RESOURCE_EXISTS=false}" },
    "shareAuth": { "value": "${VAULT_SHARE_AUTH=ManagedIdentity}" },
    "shareQuotaGiB": { "value": "${VAULT_SHARE_QUOTA_GIB=5}" },
    "deployerPrincipalId": { "value": "${AZURE_PRINCIPAL_ID}" }
  }
}
