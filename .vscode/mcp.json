{
  "inputs": [
    { "type": "promptString", "id": "adr-functions-key", "description": "ADR MCP server system key (mcp_extension). Leave empty for local.", "password": true },
    { "type": "promptString", "id": "adr-host", "description": "Function app host, e.g. func-adr-dev-scus-01.azurewebsites.net (or localhost:7071)", "password": false }
  ],
  "servers": {
    "adr-local": { "type": "http", "url": "http://localhost:7071/runtime/webhooks/mcp" },
    "adr-remote": { "type": "http", "url": "https://${input:adr-host}/runtime/webhooks/mcp", "headers": { "x-functions-key": "${input:adr-functions-key}" } },
    "azure": { "type": "stdio", "command": "npx", "args": ["-y", "@azure/mcp@latest", "server", "start"] },
    "aws-knowledge": { "type": "http", "url": "https://knowledge-mcp.global.api.aws" },
    "aws-docs": { "type": "stdio", "command": "uvx", "args": ["awslabs.aws-documentation-mcp-server@latest"], "env": { "FASTMCP_LOG_LEVEL": "ERROR", "AWS_DOCUMENTATION_PARTITION": "aws" } },
    "aws-iac": { "type": "stdio", "command": "uvx", "args": ["awslabs.aws-iac-mcp-server@latest"], "env": { "AWS_PROFILE": "${env:AWS_PROFILE}", "FASTMCP_LOG_LEVEL": "ERROR" } },
    "aws": { "type": "stdio", "command": "uvx", "args": ["mcp-proxy-for-aws@latest", "https://aws-mcp.us-east-1.api.aws/mcp"], "env": { "AWS_PROFILE": "${env:AWS_PROFILE}" } },
    "gcloud": { "type": "stdio", "command": "npx", "args": ["-y", "@google-cloud/gcloud-mcp"] },
    "gcp-storage": { "type": "stdio", "command": "npx", "args": ["-y", "@google-cloud/storage-mcp"] },
    "gcp-observability": { "type": "stdio", "command": "npx", "args": ["-y", "@google-cloud/observability-mcp"] },
    "cloud-run": { "type": "stdio", "command": "npx", "args": ["-y", "@google-cloud/cloud-run-mcp"] },
    "terraform": { "type": "stdio", "command": "docker", "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:1.3.0"] },
    "github": { "type": "http", "url": "https://api.githubcopilot.com/mcp/" }
  }
}
