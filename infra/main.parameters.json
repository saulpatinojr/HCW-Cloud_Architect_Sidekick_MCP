{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "workloadName": { "value": "${ADR_WORKLOAD_NAME=adr}" },
    "environmentShort": { "value": "${ADR_ENVIRONMENT_SHORT=dev}" },
    "nameSuffix": { "value": "${ADR_NAME_SUFFIX}" },
    "authMode": { "value": "${ADR_AUTH_MODE=FunctionKey}" },
    "entraClientId": { "value": "${ADR_ENTRA_CLIENT_ID}" },
    "entraTenantId": { "value": "${ADR_ENTRA_TENANT_ID}" },
    "entraAllowedClientIds": { "value": "${ADR_ENTRA_ALLOWED_CLIENT_IDS}" },
    "entraPipelineClientId": { "value": "${ADR_ENTRA_PIPELINE_CLIENT_ID}" },
    "entraValidateInApp": { "value": "${ADR_ENTRA_VALIDATE_IN_APP=false}" },
    "entraResourceUri": { "value": "${ADR_ENTRA_RESOURCE_URI}" },
    "enablePrivateNetworking": { "value": "${ADR_PRIVATE_NETWORKING=false}" },
    "enableDefenderForStorage": { "value": "${ADR_DEFENDER_STORAGE=false}" },
    "deployerPrincipalId": { "value": "${AZURE_PRINCIPAL_ID}" }
  }
}
